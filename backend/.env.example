AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_GROUP=
PORT=3001

# Set to true to serve hardcoded demo data instead of calling Azure.
# Lets you run the dashboard without any Azure credentials.
MOCK_DATA=false

# To use the "Destroy" feature against real Azure, the service principal
# behind DefaultAzureCredential needs delete rights (e.g. the Contributor role
# or a custom role with Microsoft.Compute/virtualMachines/delete,
# Microsoft.Compute/disks/delete, Microsoft.Compute/snapshots/delete and
# Microsoft.Network/publicIPAddresses/delete). See README "Destroying Idle
# Resources".
#
# To use the "VM Scaling" feature, the same principal also needs
# Microsoft.Compute/virtualMachines/write (Contributor covers this too).
#
# To power the "Right-Sizing Recommendations" (utilization-based), the principal
# also needs read access to Azure Monitor metrics:
# Microsoft.Insights/Metrics/Read (the "Monitoring Reader" role covers it).

# Anthropic API key for the AI Cost Analyst (natural-language Q&A over your
# cost data). Get one at https://console.anthropic.com/. Works in mock mode too.
ANTHROPIC_API_KEY=

# Optional HTTP Basic Auth for the whole app. If BOTH are set, every request
# (except /api/health) requires these credentials. Strongly recommended before
# exposing the server beyond localhost.
#
# NOTE: In production (NODE_ENV=production) with real Azure data (MOCK_DATA!=true)
# the server REFUSES TO START unless EITHER Basic Auth or Entra ID / OIDC is
# configured (fail-closed).
AUTH_USER=
AUTH_PASSWORD=

# ---------------------------------------------------------------------------
# Microsoft Entra ID / OIDC authentication (replaces Basic Auth when enabled).
#
# When ALL of OIDC_CLIENT_ID, OIDC_CLIENT_SECRET, OIDC_TENANT_ID,
# OIDC_SESSION_SECRET (>= 16 chars) and APP_BASE_URL are set, the app uses
# Entra ID instead of Basic Auth: users sign in with their Microsoft account,
# and destructive actions require the Operator role.
#
# To enable it in Azure:
#   1. Register an app under Entra ID > App registrations.
#   2. Under "Authentication" add a web redirect URI:
#        https://<your-host>/api/auth/callback
#      and enable ID tokens (optional).
#   3. Assign the app the permissions below, and grant admin consent.
#   4. (RBAC) Define an app role named "Operator" (or set OIDC_OPERATOR_ROLES
#      to match your role/group claim values) and assign users to it. Group
#      claims must be enabled to use security group IDs instead.
#
# APP_BASE_URL is your public URL and is REQUIRED (used to build the redirect
# URIs registered on the identity provider), e.g. https://dashboard.example.com.
# OIDC_OPERATOR_ROLES lists the role/group claim values allowed to destroy or
# resize resources. Comma-separated; default "Operator".
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TENANT_ID=
OIDC_SESSION_SECRET=
APP_BASE_URL=
OIDC_OPERATOR_ROLES=Operator

# Comma-separated list of allowed cross-origin origins, e.g.
#   CORS_ORIGINS=https://dashboard.example.com
# Leave empty for a single-origin deployment (recommended) — cross-origin
# requests are then rejected. Note: cross-origin calls also need CSRF-safe
# requests; mutating requests with a non-allowlisted Origin get a 403.
CORS_ORIGINS=

# Optional HTTPS endpoint that receives a copy of every audit entry
# (destroy/scale actions) so the trail survives container restarts. Point it at
# a Log Analytics ingestion, a SIEM, or any durable sink you control.
#   AUDIT_WEBHOOK_URL=https://ingest.example.com/audit
AUDIT_WEBHOOK_URL=
